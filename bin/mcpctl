#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${MCPCTL_HOME:-$(cd "$BIN_DIR/.." && pwd)}"
INSTANCES_DIR="$ROOT_DIR/instances"
COMPOSE_FILE="$ROOT_DIR/compose/docker-compose.yml"
GATEWAY_COMPOSE_FILE="$ROOT_DIR/compose/gateway-compose.yml"
GATEWAY_DIR="$ROOT_DIR/gateway"
GATEWAY_CONFIG="$GATEWAY_DIR/config.yaml"
GATEWAY_ADMIN_KEY_FILE="$GATEWAY_DIR/admin.key"
VERSIONS_FILE="$ROOT_DIR/config/versions.env"
TUNNEL_RUNNER="$ROOT_DIR/tunnel/run.sh"

source "$VERSIONS_FILE"
mkdir -p "$INSTANCES_DIR"

die(){ echo "ERROR: $*" >&2; exit 1; }
usage(){ cat <<'USAGE'
Usage:
  mcpctl add <name> <workspace> [port]
  mcpctl list
  mcpctl start|stop|restart|logs <name>
  mcpctl doctor [name]
  mcpctl remove <name> [--force]

  mcpctl gateway up|down|restart|status|logs
  mcpctl gateway list
  mcpctl gateway sync
  mcpctl gateway route|unroute <name>
  mcpctl gateway doctor

  mcpctl tunnel openai <name> [tunnel-id] [runtime-key-file]
  mcpctl tunnel cloudflare <name> [token-file]
  mcpctl tunnel cloudflare-quick <name>
  mcpctl tunnel off|status <name>
  mcpctl tunnel help

  mcpctl version
USAGE
}

validate_name(){ [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid instance name: $1"; }
instance_dir(){ printf '%s/%s' "$INSTANCES_DIR" "$1"; }
instance_env(){ printf '%s/instance.env' "$(instance_dir "$1")"; }
require_instance(){ validate_name "$1"; [[ -f "$(instance_env "$1")" ]] || die "instance '$1' does not exist"; }

read_env_value(){
  local file="$1" key="$2"
  awk -v k="$key" 'index($0,k"=")==1{sub(k"=",""); print; exit}' "$file"
}

load_instance(){
  local n="$1" file key value workspace_b64
  require_instance "$n"
  file="$(instance_env "$n")"

  for key in INSTANCE_NAME MCP_PORT MCP_IMAGE MCP_PERMISSION_MODE MCP_TELEMETRY MCP_AUTH_TOKEN MCP_GATEWAY TUNNEL_PROVIDER OPENAI_TUNNEL_ID OPENAI_RUNTIME_KEY_FILE CLOUDFLARE_MODE CLOUDFLARE_TOKEN_FILE; do
    value="$(read_env_value "$file" "$key" || true)"
    printf -v "$key" '%s' "$value"
    export "$key"
  done
  MCP_GATEWAY="${MCP_GATEWAY:-direct}"
  export MCP_GATEWAY

  workspace_b64="$(read_env_value "$file" WORKSPACE_DIR_B64 || true)"
  if [[ -n "$workspace_b64" ]]; then
    WORKSPACE_DIR="$(printf '%s' "$workspace_b64" | base64 -d 2>/dev/null)" || die "invalid WORKSPACE_DIR_B64 for instance '$n'"
  else
    # Backward compatibility with v0.x instance files.
    WORKSPACE_DIR="$(read_env_value "$file" WORKSPACE_DIR || true)"
  fi
  export WORKSPACE_DIR

  [[ "$INSTANCE_NAME" == "$n" ]] || die "instance name mismatch in $file"
  [[ "$MCP_PORT" =~ ^[0-9]+$ ]] || die "invalid MCP_PORT in $file"
  [[ -n "$MCP_IMAGE" && -n "$MCP_AUTH_TOKEN" && -n "$WORKSPACE_DIR" ]] || die "incomplete instance config: $file"
  case "$MCP_GATEWAY" in
    direct|apisix) ;;
    *) die "invalid MCP_GATEWAY in $file: $MCP_GATEWAY" ;;
  esac
}

compose_cmd(){
  local bundled="$ROOT_DIR/bin/docker-compose"
  if [[ -x "$bundled" ]]; then "$bundled" "$@";
  elif docker compose version >/dev/null 2>&1; then docker compose "$@";
  elif command -v docker-compose >/dev/null 2>&1; then docker-compose "$@";
  else die "docker compose/docker-compose not found"; fi
}
compose_instance(){ local n="$1"; shift; load_instance "$n"; compose_cmd -f "$COMPOSE_FILE" -p "coding-tools-$n" "$@"; }

port_registered(){ local p="$1" f; for f in "$INSTANCES_DIR"/*/instance.env; do [[ -f "$f" ]] || continue; grep -q "^MCP_PORT=$p$" "$f" && return 0; done; return 1; }
port_listening(){ command -v ss >/dev/null 2>&1 || return 1; ss -lntH 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$1$"; }
allocate_port(){ local p; for ((p=MCP_BASE_PORT;p<MCP_BASE_PORT+1000;p++)); do ! port_registered "$p" && ! port_listening "$p" && { echo "$p"; return; }; done; die "no free MCP port found"; }
generate_token(){ if command -v python3 >/dev/null 2>&1; then python3 -c 'import secrets; print(secrets.token_urlsafe(32))'; else openssl rand -hex 32; fi; }
encode_workspace(){ printf '%s' "$1" | base64 | tr -d '\n'; }

set_env_value(){
  local file="$1" key="$2" value="$3" tmp; tmp="$(mktemp)"
  awk -v k="$key" -v v="$value" 'BEGIN{f=0} index($0,k"=")==1{print k"="v;f=1;next}{print} END{if(!f)print k"="v}' "$file" > "$tmp"
  cat "$tmp" > "$file"; rm -f "$tmp"; chmod 600 "$file"
}
install_secret(){
  local n="$1" src="$2" dest="$3" d; [[ -s "$src" ]] || die "secret file missing: $src"
  d="$(instance_dir "$n")/secrets"; mkdir -p "$d"; chmod 700 "$d"; install -m 600 "$src" "$d/$dest"; echo "$d/$dest"
}
write_secret_value(){
  local n="$1" dest="$2" value="$3" d
  d="$(instance_dir "$n")/secrets"; mkdir -p "$d"; chmod 700 "$d"
  (umask 077; printf '%s\n' "$value" > "$d/$dest")
  chmod 600 "$d/$dest"
  echo "$d/$dest"
}
require_tty_for_secret(){ [[ -t 0 ]] || die "$1 (no TTY; provide a secret file or environment variable)"; }
prompt_line(){
  local label="$1" value
  [[ -t 0 ]] || die "$label is required (no TTY)"
  read -r -p "$label: " value
  [[ -n "$value" ]] || die "$label cannot be empty"
  printf '%s' "$value"
}
prompt_secret(){
  local label="$1" value
  require_tty_for_secret "$label is required"
  read -r -s -p "$label: " value
  printf '\n' >&2
  [[ -n "$value" ]] || die "$label cannot be empty"
  printf '%s' "$value"
}

gateway_require_files(){
  [[ -f "$GATEWAY_COMPOSE_FILE" ]] || die "gateway compose file missing: $GATEWAY_COMPOSE_FILE"
  [[ -s "$GATEWAY_CONFIG" ]] || die "gateway config missing: $GATEWAY_CONFIG (re-run install.sh)"
  [[ -s "$GATEWAY_ADMIN_KEY_FILE" ]] || die "gateway admin key missing: $GATEWAY_ADMIN_KEY_FILE (re-run install.sh)"
}
gateway_export_env(){
  gateway_require_files
  export APISIX_IMAGE ETCD_IMAGE APISIX_GATEWAY_PORT APISIX_ADMIN_PORT ETCD_CLIENT_PORT
  export GATEWAY_DATA_DIR="$GATEWAY_DIR/data"
  export GATEWAY_CONFIG_FILE="$GATEWAY_CONFIG"
  mkdir -p "$GATEWAY_DATA_DIR/etcd"
}
gateway_compose(){ gateway_export_env; compose_cmd -f "$GATEWAY_COMPOSE_FILE" -p coding-tools-gateway "$@"; }
gateway_is_running(){ docker inspect -f '{{.State.Running}}' coding-tools-mcp-apisix 2>/dev/null | grep -q true; }
gateway_admin_key(){ gateway_require_files; cat "$GATEWAY_ADMIN_KEY_FILE"; }
gateway_admin_base(){ printf 'http://127.0.0.1:%s/apisix/admin' "$APISIX_ADMIN_PORT"; }
gateway_admin_request(){
  local method="$1" path="$2" data="${3:-}" key url
  key="$(gateway_admin_key)"
  url="$(gateway_admin_base)$path"
  if [[ -n "$data" ]]; then
    curl -fsS -X "$method" -H "X-API-KEY: $key" -H 'Content-Type: application/json' --data "$data" "$url"
  else
    curl -fsS -X "$method" -H "X-API-KEY: $key" "$url"
  fi
}
gateway_wait(){
  local i
  for ((i=1; i<=30; i++)); do
    if gateway_admin_request GET /routes >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  gateway_compose ps || true
  die "APISIX Admin API did not become ready"
}
gateway_route_id(){ printf 'mcp-%s' "$1"; }
gateway_route_path(){ printf '/mcp/%s' "$1"; }
gateway_route_exists(){
  local n="$1" key code
  gateway_require_files
  key="$(gateway_admin_key)"
  code="$(curl -sS -o /dev/null -w '%{http_code}' -H "X-API-KEY: $key" "$(gateway_admin_base)/routes/$(gateway_route_id "$n")" || true)"
  [[ "$code" == 200 ]]
}
gateway_register_route(){
  local n="$1" route_id route_path payload
  require_instance "$n"
  gateway_is_running || die "APISIX gateway is not running; run: mcpctl gateway up"
  load_instance "$n"
  route_id="$(gateway_route_id "$n")"
  route_path="$(gateway_route_path "$n")"
  payload="$(cat <<JSON
{
  "name": "$route_id",
  "uri": "$route_path",
  "status": 1,
  "timeout": {"connect": 5, "send": 300, "read": 300},
  "plugins": {
    "proxy-rewrite": {"uri": "/mcp"},
    "proxy-buffering": {"disable_proxy_buffering": true}
  },
  "upstream": {
    "type": "roundrobin",
    "scheme": "http",
    "nodes": {"127.0.0.1:$MCP_PORT": 1}
  }
}
JSON
)"
  gateway_admin_request PUT "/routes/$route_id" "$payload" >/dev/null
}
gateway_unregister_route(){
  local n="$1" key code
  validate_name "$n"
  gateway_is_running || return 0
  gateway_require_files
  key="$(gateway_admin_key)"
  code="$(curl -sS -o /dev/null -w '%{http_code}' -X DELETE -H "X-API-KEY: $key" "$(gateway_admin_base)/routes/$(gateway_route_id "$n")" || true)"
  [[ "$code" == 200 || "$code" == 404 ]] || die "failed to delete APISIX route for '$n' (HTTP $code)"
}
restart_tunnel_if_active(){
  local n="$1"
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl is-active --quiet "coding-tools-tunnel@$n.service" || return 0
  systemctl restart "coding-tools-tunnel@$n.service"
}
gateway_sync(){
  local f n
  gateway_is_running || die "APISIX gateway is not running; run: mcpctl gateway up"
  for f in "$INSTANCES_DIR"/*/instance.env; do
    [[ -f "$f" ]] || continue
    n="$(basename "$(dirname "$f")")"
    set_env_value "$f" MCP_GATEWAY apisix
    gateway_register_route "$n"
    restart_tunnel_if_active "$n"
    echo "Synced $n -> http://127.0.0.1:$APISIX_GATEWAY_PORT$(gateway_route_path "$n")"
  done
}
gateway_doctor(){
  local fail=0 f n
  docker inspect -f '{{.State.Running}}' coding-tools-mcp-etcd 2>/dev/null | grep -q true && echo "[PASS] etcd container" || { echo "[FAIL] etcd container"; fail=$((fail+1)); }
  gateway_is_running && echo "[PASS] APISIX container" || { echo "[FAIL] APISIX container"; fail=$((fail+1)); }
  if gateway_admin_request GET /routes >/dev/null 2>&1; then echo "[PASS] APISIX Admin API"; else echo "[FAIL] APISIX Admin API"; fail=$((fail+1)); fi
  for f in "$INSTANCES_DIR"/*/instance.env; do
    [[ -f "$f" ]] || continue
    n="$(basename "$(dirname "$f")")"
    load_instance "$n"
    if [[ "$MCP_GATEWAY" == apisix ]]; then
      gateway_route_exists "$n" && echo "[PASS] route $(gateway_route_path "$n")" || { echo "[FAIL] route $(gateway_route_path "$n")"; fail=$((fail+1)); }
    fi
  done
  (( fail == 0 )) && echo "Gateway: HEALTHY" || { echo "Gateway: $fail check(s) failed"; return 1; }
}

show_openai_requirements(){
  cat >&2 <<'EOF'
OpenAI / ChatGPT Secure MCP Tunnel — first setup requires only:
  1. Tunnel ID
     Get/create: https://platform.openai.com/settings/organization/tunnels
  2. Runtime API key (CONTROL_PLANE_API_KEY)
     Create:     https://platform.openai.com/settings/organization/api-keys
     Permission: Tunnels Read + Use

OPENAI_ADMIN_KEY is NOT required for normal runtime. It is only needed if you
create/list/update/delete tunnels through tunnel-client admin commands.
EOF
}
show_cloudflare_requirements(){
  cat >&2 <<'EOF'
Cloudflare Tunnel — first setup requires only:
  1. Remotely-managed Tunnel token
     Dashboard: Networking > Tunnels > select tunnel > Add a replica
     Copy only the token (the long eyJ... value) from the cloudflared command.

A Cloudflare API token is NOT required to run this connector when you already
have the Tunnel token.
EOF
}

cmd_add(){
  [[ $# -ge 2 && $# -le 3 ]] || die "usage: mcpctl add <name> <workspace> [port]"
  local n="$1" w="$2" p="${3:-}" token d env workspace_b64
  validate_name "$n"; [[ ! -e "$(instance_dir "$n")" ]] || die "instance exists: $n"; [[ -d "$w" ]] || die "workspace not found: $w"
  w="$(cd "$w" && pwd -P)"; [[ -n "$p" ]] || p="$(allocate_port)"
  [[ "$p" =~ ^[0-9]+$ ]] || die "invalid port"; ! port_registered "$p" || die "port already registered"; ! port_listening "$p" || die "port already listening"
  token="$(generate_token)"; workspace_b64="$(encode_workspace "$w")"; d="$(instance_dir "$n")"; env="$d/instance.env"; mkdir -p "$d/secrets"; chmod 700 "$d" "$d/secrets"
  cat > "$env" <<ENV
INSTANCE_NAME=$n
WORKSPACE_DIR_B64=$workspace_b64
MCP_PORT=$p
MCP_IMAGE=$MCP_IMAGE
MCP_PERMISSION_MODE=$MCP_PERMISSION_MODE
MCP_TELEMETRY=off
MCP_AUTH_TOKEN=$token
MCP_GATEWAY=apisix
TUNNEL_PROVIDER=none
ENV
  chmod 600 "$env"
  compose_instance "$n" up -d
  if gateway_is_running; then
    gateway_register_route "$n"
    echo "Created $n -> http://127.0.0.1:$APISIX_GATEWAY_PORT$(gateway_route_path "$n") ($w)"
  else
    echo "Created $n -> http://127.0.0.1:$p/mcp ($w)"
    echo "WARNING: APISIX gateway is not running; run 'mcpctl gateway up' to publish the gateway route." >&2
  fi
}

cmd_list(){
  printf '%-20s %-7s %-10s %-9s %-12s %s\n' NAME PORT MCP GATEWAY TUNNEL WORKSPACE
  local f n mcp c
  for f in "$INSTANCES_DIR"/*/instance.env; do [[ -f "$f" ]] || continue; n="$(basename "$(dirname "$f")")"; load_instance "$n"; c="coding-tools-mcp-$INSTANCE_NAME"
    if docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null | grep -q true; then mcp=running; else mcp=stopped; fi
    printf '%-20s %-7s %-10s %-9s %-12s %s\n' "$INSTANCE_NAME" "$MCP_PORT" "$mcp" "$MCP_GATEWAY" "${TUNNEL_PROVIDER:-none}" "$WORKSPACE_DIR"
  done
}

cmd_start(){
  local n="$1"
  compose_instance "$n" up -d
  load_instance "$n"
  if [[ "$MCP_GATEWAY" == apisix ]]; then
    if gateway_is_running; then gateway_register_route "$n"; else echo "WARNING: APISIX gateway is not running" >&2; fi
  fi
  [[ "${TUNNEL_PROVIDER:-none}" == none ]] || systemctl start "coding-tools-tunnel@$n.service"
}
cmd_stop(){
  local n="$1"
  require_instance "$n"
  load_instance "$n"
  [[ "$MCP_GATEWAY" == apisix ]] && gateway_unregister_route "$n" || true
  systemctl stop "coding-tools-tunnel@$n.service" >/dev/null 2>&1 || true
  compose_instance "$n" stop
}
cmd_logs(){ compose_instance "$1" logs -f --tail=200; }

mcp_check_url(){
  local url="$1"
  curl -fsS -o /dev/null -H "Authorization: Bearer $MCP_AUTH_TOKEN" -H 'Accept: application/json, text/event-stream' -H 'Content-Type: application/json' \
    --data '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"mcpctl-doctor","version":"2.0"}}}' "$url"
}
doctor_one(){
  local n="$1" fail=0 c code; load_instance "$n"; c="coding-tools-mcp-$n"; echo "[$n]"
  [[ -d "$WORKSPACE_DIR" ]] && echo "[PASS] workspace" || { echo "[FAIL] workspace"; fail=$((fail+1)); }
  docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null | grep -q true && echo "[PASS] container" || { echo "[FAIL] container"; fail=$((fail+1)); }
  port_listening "$MCP_PORT" && echo "[PASS] port 127.0.0.1:$MCP_PORT" || { echo "[FAIL] port"; fail=$((fail+1)); }
  code="$(curl -sS -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' --data '{}' "http://127.0.0.1:$MCP_PORT/mcp" || true)"
  [[ "$code" == 401 ]] && echo "[PASS] auth rejects anonymous" || { echo "[FAIL] anonymous HTTP=$code"; fail=$((fail+1)); }
  mcp_check_url "http://127.0.0.1:$MCP_PORT/mcp" && echo "[PASS] authenticated initialize" || { echo "[FAIL] authenticated initialize"; fail=$((fail+1)); }

  if [[ "$MCP_GATEWAY" == apisix ]]; then
    gateway_is_running && echo "[PASS] APISIX gateway" || { echo "[FAIL] APISIX gateway"; fail=$((fail+1)); }
    gateway_route_exists "$n" && echo "[PASS] APISIX route $(gateway_route_path "$n")" || { echo "[FAIL] APISIX route"; fail=$((fail+1)); }
    mcp_check_url "http://127.0.0.1:$APISIX_GATEWAY_PORT$(gateway_route_path "$n")" && echo "[PASS] gateway initialize" || { echo "[FAIL] gateway initialize"; fail=$((fail+1)); }
  else
    echo "[INFO] gateway direct mode"
  fi

  if [[ "${TUNNEL_PROVIDER:-none}" != none ]]; then
    systemctl is-active --quiet "coding-tools-tunnel@$n.service" && echo "[PASS] tunnel service ($TUNNEL_PROVIDER)" || { echo "[FAIL] tunnel service"; fail=$((fail+1)); }
    "$TUNNEL_RUNNER" doctor "$n" >/dev/null 2>&1 && echo "[PASS] tunnel doctor" || { echo "[FAIL] tunnel doctor"; fail=$((fail+1)); }
  else echo "[INFO] tunnel disabled"; fi
  return "$fail"
}
cmd_doctor(){ local total=0 f n rc; if [[ $# -eq 1 ]]; then doctor_one "$1"; return; fi; for f in "$INSTANCES_DIR"/*/instance.env; do [[ -f "$f" ]] || continue; n="$(basename "$(dirname "$f")")"; rc=0; doctor_one "$n" || rc=$?; total=$((total+rc)); done; ((total==0)) && echo "Overall: HEALTHY" || { echo "Overall: $total check(s) failed"; return 1; }; }

cmd_remove(){
  local n="$1" force="${2:-}"; require_instance "$n"
  if [[ "$force" != --force ]]; then printf "Remove '%s'? [y/N] " "$n"; read -r a; [[ "$a" =~ ^[Yy]$ ]] || return; fi
  gateway_unregister_route "$n" || true
  systemctl disable --now "coding-tools-tunnel@$n.service" >/dev/null 2>&1 || true
  compose_instance "$n" down --remove-orphans || true
  rm -rf "$(instance_dir "$n")"
}

cmd_gateway(){
  local sub="${1:-}"; shift || true
  case "$sub" in
    up)
      [[ $# -eq 0 ]] || die "usage: mcpctl gateway up"
      gateway_compose up -d
      gateway_wait
      gateway_sync
      echo "APISIX gateway: http://127.0.0.1:$APISIX_GATEWAY_PORT"
      ;;
    down)
      [[ $# -eq 0 ]] || die "usage: mcpctl gateway down"
      gateway_compose down
      ;;
    restart)
      [[ $# -eq 0 ]] || die "usage: mcpctl gateway restart"
      gateway_compose restart
      gateway_wait
      gateway_sync
      ;;
    status)
      [[ $# -eq 0 ]] || die "usage: mcpctl gateway status"
      gateway_compose ps
      ;;
    logs)
      [[ $# -eq 0 ]] || die "usage: mcpctl gateway logs"
      gateway_compose logs -f --tail=200
      ;;
    list)
      [[ $# -eq 0 ]] || die "usage: mcpctl gateway list"
      printf '%-20s %-7s %-9s %-8s %s\n' NAME PORT MODE ROUTE GATEWAY_URL
      local f n route
      for f in "$INSTANCES_DIR"/*/instance.env; do
        [[ -f "$f" ]] || continue
        n="$(basename "$(dirname "$f")")"; load_instance "$n"; route=absent
        if gateway_is_running && gateway_route_exists "$n"; then route=active; fi
        printf '%-20s %-7s %-9s %-8s %s\n' "$n" "$MCP_PORT" "$MCP_GATEWAY" "$route" "http://127.0.0.1:$APISIX_GATEWAY_PORT$(gateway_route_path "$n")"
      done
      ;;
    sync)
      [[ $# -eq 0 ]] || die "usage: mcpctl gateway sync"
      gateway_sync
      ;;
    route)
      [[ $# -eq 1 ]] || die "usage: mcpctl gateway route <name>"
      local n="$1"; require_instance "$n"
      set_env_value "$(instance_env "$n")" MCP_GATEWAY apisix
      gateway_register_route "$n"
      restart_tunnel_if_active "$n"
      echo "Routed $n -> http://127.0.0.1:$APISIX_GATEWAY_PORT$(gateway_route_path "$n")"
      ;;
    unroute)
      [[ $# -eq 1 ]] || die "usage: mcpctl gateway unroute <name>"
      local n="$1"; require_instance "$n"
      gateway_unregister_route "$n"
      set_env_value "$(instance_env "$n")" MCP_GATEWAY direct
      restart_tunnel_if_active "$n"
      echo "Unrouted $n; tunnel target returned to direct MCP"
      ;;
    doctor)
      [[ $# -eq 0 ]] || die "usage: mcpctl gateway doctor"
      gateway_doctor
      ;;
    help|-h|--help)
      usage
      ;;
    *) die "usage: mcpctl gateway {up|down|restart|status|logs|list|sync|route|unroute|doctor}" ;;
  esac
}

cmd_tunnel(){
  local sub="${1:-}"; shift || true
  case "$sub" in
    openai)
      [[ $# -ge 1 && $# -le 3 ]] || die "usage: mcpctl tunnel openai <name> [tunnel-id] [runtime-key-file]"
      local n="$1" tid="${2:-}" key_file="${3:-}" key_path="" key_value="" saved_tid="" saved_key_path="" help_shown=0
      require_instance "$n"
      saved_tid="$(read_env_value "$(instance_env "$n")" OPENAI_TUNNEL_ID || true)"
      saved_key_path="$(read_env_value "$(instance_env "$n")" OPENAI_RUNTIME_KEY_FILE || true)"
      [[ -n "$tid" ]] || tid="${OPENAI_TUNNEL_ID:-$saved_tid}"
      if [[ -z "$tid" ]]; then
        show_openai_requirements; help_shown=1
        tid="$(prompt_line 'OpenAI Tunnel ID')"
      fi
      [[ "$tid" =~ ^tunnel_[0-9a-f]{32}$ ]] || die "invalid OpenAI Tunnel ID: expected tunnel_ followed by 32 lowercase hex characters"

      if [[ -n "$key_file" ]]; then
        key_path="$(install_secret "$n" "$key_file" openai_runtime_key)"
      elif [[ -n "$saved_key_path" && -s "$saved_key_path" ]]; then
        key_path="$saved_key_path"
      elif [[ -s "$(instance_dir "$n")/secrets/openai_runtime_key" ]]; then
        key_path="$(instance_dir "$n")/secrets/openai_runtime_key"
      else
        key_value="${CONTROL_PLANE_API_KEY:-${OPENAI_RUNTIME_KEY:-}}"
        if [[ -z "$key_value" ]]; then
          (( help_shown == 1 )) || show_openai_requirements
          key_value="$(prompt_secret 'OpenAI Runtime API Key')"
        fi
        key_path="$(write_secret_value "$n" openai_runtime_key "$key_value")"
        unset key_value
      fi

      set_env_value "$(instance_env "$n")" TUNNEL_PROVIDER openai
      set_env_value "$(instance_env "$n")" OPENAI_TUNNEL_ID "$tid"
      set_env_value "$(instance_env "$n")" OPENAI_RUNTIME_KEY_FILE "$key_path"
      systemctl daemon-reload
      systemctl enable --now "coding-tools-tunnel@$n.service"
      load_instance "$n"
      echo "OpenAI tunnel configured for '$n'."
      [[ "$MCP_GATEWAY" == apisix ]] && echo "MCP target: http://127.0.0.1:$APISIX_GATEWAY_PORT$(gateway_route_path "$n")"
      echo "Required manual ChatGPT step:"
      echo "  https://chatgpt.com/#settings/Connectors"
      echo "  Create/select connector -> Connection: Tunnel -> select or paste: $tid"
      ;;
    cloudflare)
      [[ $# -ge 1 && $# -le 2 ]] || die "usage: mcpctl tunnel cloudflare <name> [token-file]"
      local n="$1" token_file="${2:-}" tok="" token_value="" saved_token_path=""
      require_instance "$n"
      saved_token_path="$(read_env_value "$(instance_env "$n")" CLOUDFLARE_TOKEN_FILE || true)"
      if [[ -n "$token_file" ]]; then
        tok="$(install_secret "$n" "$token_file" cloudflare_token)"
      elif [[ -n "$saved_token_path" && -s "$saved_token_path" ]]; then
        tok="$saved_token_path"
      elif [[ -s "$(instance_dir "$n")/secrets/cloudflare_token" ]]; then
        tok="$(instance_dir "$n")/secrets/cloudflare_token"
      else
        token_value="${CLOUDFLARE_TUNNEL_TOKEN:-}"
        if [[ -z "$token_value" ]]; then
          show_cloudflare_requirements
          token_value="$(prompt_secret 'Cloudflare Tunnel Token')"
        fi
        tok="$(write_secret_value "$n" cloudflare_token "$token_value")"
        unset token_value
      fi
      set_env_value "$(instance_env "$n")" TUNNEL_PROVIDER cloudflare
      set_env_value "$(instance_env "$n")" CLOUDFLARE_MODE token
      set_env_value "$(instance_env "$n")" CLOUDFLARE_TOKEN_FILE "$tok"
      load_instance "$n"
      systemctl daemon-reload
      systemctl enable --now "coding-tools-tunnel@$n.service"
      echo "Cloudflare tunnel configured for '$n'."
      echo "Required manual Cloudflare step:"
      echo "  Dashboard: Networking > Tunnels > select tunnel > Routes > Add route > Published application"
      if [[ "$MCP_GATEWAY" == apisix ]]; then
        echo "  Service URL: http://127.0.0.1:$APISIX_GATEWAY_PORT"
        echo "External MCP URL: https://<your-hostname>$(gateway_route_path "$n")"
      else
        echo "  Service URL: http://127.0.0.1:$MCP_PORT"
        echo "External MCP URL: https://<your-hostname>/mcp"
      fi
      echo "External MCP clients must send the instance Bearer token."
      echo "The token already exists as MCP_AUTH_TOKEN in $(instance_env "$n"); no new token is required."
      ;;
    cloudflare-quick)
      [[ $# -eq 1 ]] || die "usage: mcpctl tunnel cloudflare-quick <name>"
      local n="$1"; require_instance "$n"; set_env_value "$(instance_env "$n")" TUNNEL_PROVIDER cloudflare; set_env_value "$(instance_env "$n")" CLOUDFLARE_MODE quick
      systemctl daemon-reload; systemctl enable --now "coding-tools-tunnel@$n.service"
      ;;
    off)
      [[ $# -eq 1 ]] || die "usage: mcpctl tunnel off <name>"
      local n="$1"; require_instance "$n"; systemctl disable --now "coding-tools-tunnel@$n.service" >/dev/null 2>&1 || true; set_env_value "$(instance_env "$n")" TUNNEL_PROVIDER none
      ;;
    status)
      [[ $# -eq 1 ]] || die "usage: mcpctl tunnel status <name>"
      local n="$1"; require_instance "$n"; systemctl status "coding-tools-tunnel@$n.service" --no-pager || true; "$TUNNEL_RUNNER" doctor "$n"
      ;;
    help|-h|--help)
      cat <<'EOF'
Tunnel setup (minimal interaction):

  OpenAI / ChatGPT:
    mcpctl tunnel openai <name>
    Prompts only for missing Tunnel ID and Runtime API Key.
    In APISIX mode the local MCP target is /mcp/<instance>.
    Optional non-interactive inputs:
      arg 2 / OPENAI_TUNNEL_ID
      arg 3 = runtime key file
      CONTROL_PLANE_API_KEY or OPENAI_RUNTIME_KEY

  Cloudflare:
    mcpctl tunnel cloudflare <name>
    Prompts only for a missing remotely-managed Tunnel token.
    In APISIX mode publish http://127.0.0.1:9080 and use /mcp/<instance>.
    Optional non-interactive inputs:
      arg 2 = tunnel token file
      CLOUDFLARE_TUNNEL_TOKEN

Secrets entered interactively are hidden and stored with mode 0600.
Existing stored secrets are reused without prompting.
EOF
      ;;
    *) die "usage: mcpctl tunnel {openai|cloudflare|cloudflare-quick|off|status|help} ..." ;;
  esac
}

case "${1:-}" in
  add) shift; cmd_add "$@";;
  list|ls) cmd_list;;
  start) shift; cmd_start "$@";;
  stop) shift; cmd_stop "$@";;
  restart) shift; cmd_stop "$1"; cmd_start "$1";;
  logs) shift; cmd_logs "$@";;
  doctor) shift; cmd_doctor "$@";;
  remove|rm) shift; cmd_remove "$@";;
  gateway) shift; cmd_gateway "$@";;
  tunnel) shift; cmd_tunnel "$@";;
  version|-v|--version) echo "deploy=$DEPLOY_VERSION mcp=$CODING_TOOLS_MCP_VERSION compose=$DOCKER_COMPOSE_VERSION apisix=$APISIX_VERSION etcd=$ETCD_IMAGE openai=$OPENAI_TUNNEL_CLIENT_VERSION cloudflared=$CLOUDFLARED_VERSION";;
  *) usage;;
esac
